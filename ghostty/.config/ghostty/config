theme = Catppuccin Mocha
background-opacity = 1.0
background-blur-radius = 20
window-decoration = false

font-family = JetBrains Mono Regular
font-size = 20

background-image = ~/.config/ghostty/backgrounds/dark-water-1.jpeg
background-image-fit = cover
background-image-opacity = 0.15

window-save-state = never
quit-after-last-window-closed = true
keybind = global:page_down=toggle_quick_terminal
keybind = global:f6=toggle_quick_terminal

# Scroll scrollback like vim/tmux copy-mode (bare shell, no multiplexer)
keybind = super+u=scroll_page_fractional:-0.5
keybind = super+d=scroll_page_fractional:0.5

custom-shader = shaders/cursor_warp.glsl

link-url = true
